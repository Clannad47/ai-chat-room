APP_NAME=AI Chat Room
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATA_DIR=data
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DEFAULT_USER_NAME=demo
DEFAULT_USER_DISPLAY_NAME=Demo User

# Optional seed values. Configure models in the UI after first start.
# These are only used when the llm_settings table is first created.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4.1-flash

AGENT_MAX_STEPS=8
AGENT_MAX_CONTEXT_CHARS=16000
AGENT_MAX_DEPTH=3
AGENT_MAX_TASKS_PER_ROOT=24
AGENT_REPLY_MAX_CHARS=16000
TOOL_TIMEOUT_SECONDS=20
TOOL_RESULT_MAX_CHARS=8000
FETCH_MAX_BYTES=100000
ROOM_HISTORY_LIMIT=100
